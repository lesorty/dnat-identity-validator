@startuml
title DNAT - Stage 1
caption A single confidential VM concentrates all system components

left to right direction
skinparam backgroundColor #FCFCFD
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #14324A
skinparam dpi 180
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 80
skinparam roundcorner 18
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam ArrowColor #355C7D
skinparam ArrowThickness 1.4
skinparam wrapWidth 220
skinparam maxMessageSize 140

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #4B6584
  FontColor #14324A
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #577590
  FontColor #14324A
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #577590
  FontColor #14324A
}
skinparam cloud {
  BackgroundColor #F5F7FA
  BorderColor #829AB1
  FontColor #243B53
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D4B85F
  FontColor #5C4813
}
skinparam rectangle<<mainvm>> {
  BackgroundColor #EAF4FF
  BorderColor #2F6FB5
  FontColor #113A63
}
skinparam rectangle<<microvm>> {
  BackgroundColor #FFFDF2
  BorderColor #C0A000
  FontColor #6E5A00
}
skinparam database<<secret>> {
  BackgroundColor #E8ECFF
  BorderColor #5B6EE1
  FontColor #263A99
}

cloud "User / Operator" as U
cloud "Internet / external services" as NET

rectangle "Single confidential CVM" <<mainvm>> as ALL {
  component "Frontend + API\nIPFS + Marketplace" as FE
  component "Execution\norchestrator" as ORCH
  rectangle "execution microVM" <<microvm>> as EXECM
  database "Sensitive data\nwallet, keys,\nartifacts, and datasets" <<secret>> as SEC
}

U --> FE : upload, query,\nexecution
FE --> ORCH : trigger execution
ORCH --> EXECM : start guest
EXECM --> NET : outbound calls
EXECM --> SEC : use local artifacts

note right of ALL
Everything remains in the same domain:
- control
- execution
- network
- sensitive storage
end note

@enduml
