@startuml
title DNAT - Etapa 3
caption A execucao passa a ser isolada em uma CVM dedicada, responsavel apenas por receber o bundle e acionar a microVM

left to right direction
skinparam backgroundColor #FCFCFD
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #14324A
skinparam dpi 180
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 80
skinparam roundcorner 18
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam ArrowColor #355C7D
skinparam ArrowThickness 1.4
skinparam wrapWidth 220
skinparam maxMessageSize 140

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #4B6584
  FontColor #14324A
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #577590
  FontColor #14324A
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #577590
  FontColor #14324A
}
skinparam cloud {
  BackgroundColor #F5F7FA
  BorderColor #829AB1
  FontColor #243B53
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D4B85F
  FontColor #5C4813
}
skinparam rectangle<<mainvm>> {
  BackgroundColor #EAF4FF
  BorderColor #2F6FB5
  FontColor #113A63
}
skinparam rectangle<<execvm>> {
  BackgroundColor #EEF9F1
  BorderColor #2E8B57
  FontColor #1F5C3E
}
skinparam rectangle<<microvm>> {
  BackgroundColor #FFFDF2
  BorderColor #C0A000
  FontColor #6E5A00
}
skinparam database<<secret>> {
  BackgroundColor #E8ECFF
  BorderColor #5B6EE1
  FontColor #263A99
}

cloud "Usuario / Operador" as U

rectangle "CVM principal" <<mainvm>> as MAIN {
  component "Frontend + API" as FE
  component "IPFS + Marketplace" as APP
  database "Dados sensiveis\nwallet, chaves,\nartefatos e datasets" <<secret>> as SEC
}

rectangle "CVM executora" <<execvm>> as EXEC {
  component "API de execucao" as API
  rectangle "microVM executora" <<microvm>> as M
}

U --> FE : solicita execucao
FE --> API : envia bundle temporario
API --> M : inicializa guest
M --> API : retorna resultado
API --> FE : entrega saida
FE --> U : resposta final

note bottom of EXEC
Esta VM existe apenas para executar.
Sem IPFS, sem wallet e sem armazenamento sensivel persistente.
end note

@enduml
