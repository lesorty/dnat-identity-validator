@startuml
title DNAT - Architecture Overview

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #2E4057
skinparam ArrowThickness 1.2
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam nodesep 70
skinparam ranksep 90
skinparam node {
  BackgroundColor #F7FAFC
  BorderColor #2E4057
  FontColor #1F2933
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #486581
  FontColor #102A43
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #486581
  FontColor #102A43
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #486581
  FontColor #102A43
}

actor "User / Browser" as User

node "CVM1\nClient and access layer" as CVM1 {
  component "dnat-client\nFrontend + API" as CLIENT
  database "Local IPFS" as IPFS
  component "Marketplace\ncontract + encryption" as MARKET
}

node "CVM2\nIsolated builder" as CVM2 {
  component "dnat-builder\nBuild API" as BUILDER
  component "ephemeral worker" as WORKER
  database ".whl cache" as WHEELCACHE
}

node "CVM3\nIsolated executor" as CVM3 {
  component "dnat-executor\nExecution API" as EXECUTOR
}

node "build microVM\nFirecracker" as BUILDVM
node "execution microVM\nFirecracker" as EXECVM

artifact "application.ext4" as APPART
artifact "dataset + result.json\nstdout/stderr" as EXECART

BUILDVM -[hidden]down- APPART
EXECVM -[hidden]down- EXECART
CVM1 -[hidden]right- CVM2
CVM2 -[hidden]right- CVM3

User -down-> CLIENT : B1 / E1\nupload / query /\nexecute
CLIENT -up-> User : B7 / E6\nfinal response

CLIENT -right-> BUILDER : B2\nbuild\nbundle
BUILDER -down-> WORKER : B3\ncreate worker\nper request
WORKER -left-> BUILDVM : B4\nbuild-vm.sh
BUILDVM -down-> APPART : B5\ngenerate\nartifact
BUILDVM -up-> WHEELCACHE : B5a\nreuse /\ngenerate wheels
BUILDER -left-> CLIENT : B6\napplication.ext4 +\nbuild-result.json

CLIENT -down-> IPFS : B7a\npublish encrypted\nblob

CLIENT -right-> EXECUTOR : E2\nexecution\nbundle
EXECUTOR -down-> EXECVM : E3\nrun-vm.sh
EXECVM -down-> EXECART : E4\nwrite\noutput
EXECUTOR -left-> CLIENT : E5\nresult.json +\nstdout/stderr

note right of CVM2
Persistent:
- .whl cache

Ephemeral:
- worker
- temporary disks
- build microVM
end note

note right of CVM3
Persistent:
- base runtime

Ephemeral:
- execution bundle
- execution microVM
- input/output disks
end note

@enduml
