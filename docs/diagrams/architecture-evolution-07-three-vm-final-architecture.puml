@startuml
title DNAT - Stage 7
caption Current architecture with three VMs and compartmentalized failures

left to right direction
skinparam backgroundColor #FCFCFD
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontColor #14324A
skinparam dpi 180
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 80
skinparam roundcorner 18
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam ArrowColor #355C7D
skinparam ArrowThickness 1.4
skinparam wrapWidth 220
skinparam maxMessageSize 140

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #4B6584
  FontColor #14324A
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #577590
  FontColor #14324A
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #577590
  FontColor #14324A
}
skinparam cloud {
  BackgroundColor #F5F7FA
  BorderColor #829AB1
  FontColor #243B53
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #D4B85F
  FontColor #5C4813
}
skinparam rectangle<<mainvm>> {
  BackgroundColor #EAF4FF
  BorderColor #2F6FB5
  FontColor #113A63
}
skinparam rectangle<<buildvm>> {
  BackgroundColor #FFF1E6
  BorderColor #D97706
  FontColor #7C3E0A
}
skinparam rectangle<<execvm>> {
  BackgroundColor #EEF9F1
  BorderColor #2E8B57
  FontColor #1F5C3E
}
skinparam rectangle<<microvm>> {
  BackgroundColor #FFFDF2
  BorderColor #C0A000
  FontColor #6E5A00
}
skinparam database<<secret>> {
  BackgroundColor #E8ECFF
  BorderColor #5B6EE1
  FontColor #263A99
}
skinparam database<<storage>> {
  BackgroundColor #F3F7FB
  BorderColor #6C8EBF
  FontColor #294A70
}

cloud "User / Operator" as U
cloud "Internet / package indexes" as NET

rectangle "Main CVM" <<mainvm>> as MAIN {
  component "dnat-client\nFrontend + API" as FE
  component "IPFS + Marketplace" as APP
  database "Sensitive data\nwallet, keys,\nblobs, and datasets" <<secret>> as SEC
}

rectangle "Builder CVM" <<buildvm>> as BUILD {
  component "dnat-builder" as APIB
  component "ephemeral worker" as WORK
  rectangle "build microVM" <<microvm>> as B
  database ".whl cache" <<storage>> as WHL
}

rectangle "Executor CVM" <<execvm>> as EXEC {
  component "dnat-executor" as APIE
  rectangle "execution microVM\nwithout network" <<microvm>> as E
  database "persistent output disk" <<storage>> as OUT
}

U --> FE : registration and execution
FE --> APIB : build bundle
APIB --> WORK : create worker
WORK --> B : build-vm.sh
B --> WHL : reuse / build wheels
B --> NET : download dependencies
APIB --> FE : application.ext4

FE --> APIE : execution bundle
APIE --> E : run-vm.sh
E --> OUT : write result
OUT --> APIE : collect output
APIE --> FE : result.json

B -[#C73E1D,dashed,thickness=2]-> SEC : access attempt
note on link #FFF7D6
no reachability: the builder neither stores
nor sees the main CVM's sensitive data
end note

note right of MAIN
Only layer with sensitive persistence:
- wallet and keys
- IPFS
- blobs and datasets
end note

note bottom of BUILD
Even after compromise, the builder reaches only:
- .whl cache
- ephemeral build state
end note

note bottom of EXEC
Even after compromise, the executor reaches only:
- temporary bundle
- execution outputs
end note

@enduml
