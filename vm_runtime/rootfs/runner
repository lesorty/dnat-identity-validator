#!/usr/bin/env python3

import json
import os
import shutil
import signal
import stat
import subprocess
import sys
import time
from pathlib import Path

WORKDIR = '/tmp/exec'
INPUT_DISKS = ['/dev/vdb', '/dev/vdc', '/dev/vdd', '/dev/vde']
OUTPUT_MARKER = 'dnat-output.marker'
APPLICATION_MARKER = 'dnat-application.marker'
RESULT_PATH = 'result.json'
EXECUTION_COMPLETE_MARKER = 'EXECUTION_COMPLETE'
# T-804: stdout e stderr do script sao descartados; so o arquivo de metricas sai, com teto de bytes.
# O host (executor.py, job_output.py) revalida o esquema e o teto configurados.
METRICS_PATH = 'workspace/metrics.json'
METRICS_READ_CAP = 64 * 1024
# T-802: o limite do script vem do host na linha de comando do kernel (dnat.job_timeout=N).
DEFAULT_JOB_TIMEOUT = 600


def job_timeout() -> int:
    try:
        for arg in Path('/proc/cmdline').read_text().split():
            if arg.startswith('dnat.job_timeout='):
                value = int(arg.split('=', 1)[1])
                if value > 0:
                    return value
    except (OSError, ValueError):
        pass
    return DEFAULT_JOB_TIMEOUT


def read_metrics() -> dict:
    try:
        fd = os.open(METRICS_PATH, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return {"metrics_error": "missing"}
    except OSError:
        return {"metrics_error": "not_regular_file"}
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return {"metrics_error": "not_regular_file"}
        data = os.read(fd, METRICS_READ_CAP + 1)
    finally:
        os.close(fd)
    if len(data) > METRICS_READ_CAP:
        return {"metrics_error": "too_large"}
    return {"metrics_text": data.decode('utf-8', errors='replace')}


def run_job(limit: int) -> dict:
    started = time.monotonic()
    proc = subprocess.Popen(
        ['bash', 'workspace/run.sh'],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    timed_out = False
    try:
        proc.wait(timeout=limit)
    except subprocess.TimeoutExpired:
        timed_out = True
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        proc.wait()
    return {
        "returncode": 124 if timed_out else proc.returncode,
        "timed_out": timed_out,
        "elapsed_seconds": time.monotonic() - started,
        **read_metrics(),
    }


def safe_mount(device: str, mount_dir: str) -> bool:
    result = subprocess.run(
        ['mount', device, mount_dir],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def discover_mounts() -> tuple[str | None, str | None, str | None]:
    mounted: dict[str, str] = {}

    for _ in range(30):
        bundle_path = None
        output_dir = None
        application_dir = None

        for disk in INPUT_DISKS:
            if not os.path.exists(disk):
                continue

            mount_dir = mounted.get(disk)
            if mount_dir is None:
                mount_dir = f"/mnt/{os.path.basename(disk)}"
                os.makedirs(mount_dir, exist_ok=True)
                if not safe_mount(disk, mount_dir):
                    continue
                mounted[disk] = mount_dir

            candidate_bundle = os.path.join(mount_dir, 'bundle.tar.gz')
            if bundle_path is None and os.path.isfile(candidate_bundle):
                bundle_path = candidate_bundle

            if output_dir is None and os.path.isfile(os.path.join(mount_dir, OUTPUT_MARKER)):
                output_dir = mount_dir

            if application_dir is None and os.path.isfile(os.path.join(mount_dir, APPLICATION_MARKER)):
                application_dir = mount_dir

        if bundle_path and output_dir:
            return bundle_path, output_dir, application_dir

        time.sleep(1)

    return None, None, None


def persist_output(output_dir: str | None, output: dict) -> None:
    if not output_dir:
        return

    output_path = Path(output_dir)
    temp_result = output_path / f"{RESULT_PATH}.tmp"
    temp_result.write_text(json.dumps(output), encoding='utf-8')
    temp_result.replace(output_path / RESULT_PATH)
    subprocess.run(['sync'], check=False)


def write_serial(message: str) -> None:
    try:
        with open('/dev/ttyS0', 'a', encoding='utf-8', errors='ignore') as serial:
            serial.write(f"{message}\n")
            serial.flush()
    except OSError:
        pass

os.makedirs(WORKDIR, exist_ok=True)
os.chdir(WORKDIR)

bundle_path, output_dir, application_dir = discover_mounts()

try:
    if not bundle_path or not os.path.isfile(bundle_path):
        raise Exception("Bundle not found")
    if not output_dir:
        raise Exception("Output disk not found")

    app_symlink = Path('/mnt/dnat-app')
    if application_dir:
        try:
            if app_symlink.exists() or app_symlink.is_symlink():
                app_symlink.unlink()
        except OSError:
            pass
        os.symlink(application_dir, app_symlink)

    shutil.copyfile(bundle_path, 'bundle.tar.gz')
    
    # Extract
    result = subprocess.run(['tar', '-xzf', 'bundle.tar.gz'], capture_output=True, text=True)
    if result.returncode != 0:
        raise Exception("failed to extract bundle")
    
    # Execute (saida bruta descartada; limite vindo do host)
    output = run_job(job_timeout())

except Exception as e:
    # So mensagens do proprio runner, que o host traduz para codigos fixos.
    output = {"error": str(e)}

finally:
    persist_output(output_dir, output)
    write_serial(EXECUTION_COMPLETE_MARKER)
    sys.exit(0)
